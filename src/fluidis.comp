#version 450

precision highp float;
precision highp int;
precision highp image2D;

uniform float time;
uniform vec2 resolution;
uniform vec2 mouse;
uniform vec3 spectrum;

layout(local_size_x = LOCAL_SIZE_X,
       local_size_y = LOCAL_SIZE_Y,
       local_size_z = LOCAL_SIZE_Z) in;

layout(binding = 0, rgba32f) uniform writeonly image2D prevPass;
layout(binding = 1, rgba32f) uniform readonly  image2D prevFrame;

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    mat2 rot = mat2(1.6, 1.2, -1.2, 1.6);
    for (int i = 0; i < 5; i++) {
        v += a * noise(p);
        p = rot * p;
        a *= 0.5;
    }
    return v;
}

vec2 curlNoise(vec2 p, float t) {
    float e = 0.01;
    float n1 = fbm(p + vec2(0.0, e) + t * 0.15);
    float n2 = fbm(p - vec2(0.0, e) + t * 0.15);
    float n3 = fbm(p + vec2(e, 0.0) + vec2(17.0, 3.0) + t * 0.12);
    float n4 = fbm(p - vec2(e, 0.0) + vec2(17.0, 3.0) + t * 0.12);
    return vec2(n1 - n2, n4 - n3) / (2.0 * e);
}

vec3 palette(float x) {
    x = clamp(x, 0.0, 1.0);
    vec3 c0 = vec3(0.02, 0.03, 0.06);
    vec3 c1 = vec3(0.02, 0.35, 0.42);
    vec3 c2 = vec3(0.05, 0.85, 0.72);
    vec3 c3 = vec3(0.95, 0.72, 0.22);
    vec3 c4 = vec3(1.00, 0.95, 0.88);
    float s = x * 4.0;
    if (s < 1.0) return mix(c0, c1, s);
    if (s < 2.0) return mix(c1, c2, s - 1.0);
    if (s < 3.0) return mix(c2, c3, s - 2.0);
    return mix(c3, c4, s - 3.0);
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(prevPass);
    if (id.x >= sz.x || id.y >= sz.y) return;

    vec2 uv = (vec2(id) + 0.5) / vec2(sz);
    float aspect = float(sz.x) / float(sz.y);
    vec2 p = (uv - 0.5) * vec2(aspect, 1.0);

    // incompressible velocity via curl of FBM potential
    vec2 vel = curlNoise(p * 2.2, time * 0.35);
    vel += 0.45 * curlNoise(p * 5.5 + 10.0, time * 0.55);
    vel += 0.20 * curlNoise(p * 11.0 - 4.0, -time * 0.25);
    vel *= 0.90;

    vec2 m = mouse;
    if (length(m) < 1e-5) {
        m = 0.5 + 0.22 * vec2(cos(time * 0.7), sin(time * 0.55));
    }
    vec2 mp = (m - 0.5) * vec2(aspect, 1.0);
    vec2 toM = mp - p;
    float md = length(toM);
    vel += vec2(-toM.y, toM.x) / (md * md + 0.04) * 0.35;

    // semi-Lagrangian advection of previous compute frame
    vec2 advUV = uv - vel * vec2(1.0 / max(aspect, 0.001), 1.0) * 0.016;
    ivec2 advId = ivec2(clamp(advUV, vec2(0.0), vec2(0.999)) * vec2(sz));

    vec3 prev = imageLoad(prevFrame, advId).rgb;
    prev += imageLoad(prevFrame, clamp(advId + ivec2(1, 0), ivec2(0), sz - 1)).rgb;
    prev += imageLoad(prevFrame, clamp(advId - ivec2(1, 0), ivec2(0), sz - 1)).rgb;
    prev += imageLoad(prevFrame, clamp(advId + ivec2(0, 1), ivec2(0), sz - 1)).rgb;
    prev += imageLoad(prevFrame, clamp(advId - ivec2(0, 1), ivec2(0), sz - 1)).rgb;
    prev *= 0.2;
    prev *= 0.975;

    // dye injection
    float inject = exp(-md * md * 90.0);
    float pulse = 0.55 + 0.45 * sin(time * 6.0);
    vec3 dye = palette(0.55 + 0.35 * sin(time * 1.7 + md * 8.0)) * inject * pulse * 1.35;

    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float ang = time * (0.4 + fi * 0.07) + fi * 1.7;
        vec2 cpos = 0.32 * vec2(cos(ang + fi), sin(ang * 0.85 - fi * 0.5));
        float dd = length(p - cpos);
        float blob = exp(-dd * dd * (55.0 + 20.0 * sin(time * 2.0 + fi)));
        dye += palette(0.25 + 0.2 * fi + 0.1 * sin(time + fi)) * blob * 0.55;
    }
    dye += palette(0.85) * spectrum.x * 0.2 * exp(-length(p) * 3.0);

    vec3 col = prev + dye;
    float curlMag = length(vel) * 0.15;
    vec3 iris = 0.5 + 0.5 * cos(atan(vel.y, vel.x) * 2.0 + vec3(0.0, 2.0, 4.0));
    col += iris * smoothstep(0.02, 0.25, length(col)) * (0.3 + curlMag);

    float vig = smoothstep(1.35, 0.25, length(p));
    col *= vig;
    col += (hash21(vec2(id) + fract(time) * 100.0) - 0.5) * 0.03;
    col = col / (1.0 + col * 0.35);
    col = pow(max(col, vec3(0.0)), vec3(0.92));

    imageStore(prevPass, id, vec4(col, 1.0));
}
